generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// МУЛЬТИТЕНАНТНОСТЬ
// ============================================================

model Company {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique  // для сабдомена: slug.yourdomain.com
  logoUrl     String?

  // Баланс — пополняется крипто-инвойсами (Invoice), списывается автоматически
  // BillingCron'ом раз в день за активную подписку. Подписка не покупается напрямую:
  // деньги сначала оседают на балансе, тариф выбирается/продлевается списанием с него.
  balance Decimal @db.Decimal(10, 2) @default(0)

  // Подписка
  plan            SubscriptionPlan @default(TRIAL)
  planExpiresAt   DateTime? // когда наступит следующее автосписание; null = тариф не продлевается автоматически (TRIAL/ENTERPRISE)
  maxProjects     Int @default(1)
  maxClients      Int @default(1000)
  // Лимит рассылок был помесячным до 2026-07-30 (запрос пользователя: "поменять саму подписку,
  // пусть будет по проектам, клиентам, рассылок В ДЕНЬ") — переведён на дневной. Значения теперь
  // "ставка в день на каждый доступный проект" × maxProjects этого тарифа, посчитано заранее в
  // PLANS (apps/api/src/modules/billing/plans.ts), а не хранится как отдельная формула здесь.
  maxPushesPerDay Int @default(2)

  // Лимиты использования
  currentProjects Int @default(0)
  currentClients  Int @default(0)
  pushesToday     Int @default(0)
  pushesResetAt   DateTime @default(now())

  // Ручные ограничения супер-админа (Фаза 4.3D, запрос пользователя 2026-07-19) — независимы
  // от планов/лимитов подписки выше, накладываются вручную через apps/admin. isSuspended
  // проверяется в checkSubscriptionLimit (блокирует projects/clients/pushes целиком) И в
  // AuthService.login()/refresh() (новые логины/рефреши блокируются сразу; уже выданный
  // access-токен, 15 мин, отрабатывает до истечения — осознанный компромисс). pushesBlocked —
  // только пуши, тоже через checkSubscriptionLimit (единая точка для SubscriptionGuard и
  // PushesCron.fireScheduledPushes). domainsBlocked — проверяется в DomainsService.create().
  pushesBlocked  Boolean @default(false)
  domainsBlocked Boolean @default(false)
  isSuspended    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  users               User[]
  projects            Project[]
  domains             Domain[]
  landings            Landing[]
  invoices            Invoice[]
  balanceTransactions BalanceTransaction[]
  teamInvites         TeamInvite[]
  errorLogs           ErrorLog[]
  adminActionLogs     AdminActionLog[]
}

// Super Admin панель (Фаза 4.3, запрос пользователя 2026-07-19) — первая по-настоящему
// кросс-тенантная поверхность в проекте, намеренно НЕ в modelsWithCompany
// (PrismaService middleware) — платформенному супер-админу нужен доступ ко всем компаниям
// сразу, не к одной. companyId/userId nullable — публичные роуты (tracking/webhooks) не
// всегда несут авторизованного пользователя/компанию.
model ErrorLog {
  id         String   @id @default(cuid())
  companyId  String?
  userId     String?
  message    String
  stack      String?
  route      String?
  method     String?
  statusCode Int?
  createdAt  DateTime @default(now())

  company Company? @relation(fields: [companyId], references: [id])

  @@index([companyId, createdAt])
  @@index([createdAt])
}

// Аудит ручных действий супер-админа (Фаза 4.3) — начинается с ручной активации подписки
// (action: 'SUBSCRIPTION_CHANGE'), action — строка, а не enum, задел на будущие типы действий
// без миграции. Затрагивает выручку компании без обычного крипто-инвойса, поэтому пишется в
// отдельную просматриваемую таблицу, а не только в серверный лог.
model AdminActionLog {
  id            String   @id @default(cuid())
  adminUserId   String
  companyId     String
  action        String
  previousValue Json
  newValue      Json
  createdAt     DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id])
  // FK на User (Фаза 4.3A, запрос пользователя 2026-07-19 — задел на несколько будущих
  // супер-админов) — без неё вкладка "Действия" в apps/admin могла бы показать только сырой
  // adminUserId, не имя/email. Добавлена сейчас, пока таблица почти пустая, дешевле мигрировать
  // до накопления реальных данных, чем после.
  admin User @relation(fields: [adminUserId], references: [id])

  @@index([companyId, createdAt])
}

// ============================================================
// ПОЛЬЗОВАТЕЛИ И РОЛИ
// ============================================================

model User {
  id           String   @id @default(cuid())
  companyId    String
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String?
  role         UserRole @default(BUYER)
  avatarUrl    String?
  isActive     Boolean  @default(true)
  lastLoginAt  DateTime?

  // Видимость страницы "все лендинги компании" (запрос пользователя 2026-08-03) — не
  // per-project (в отличие от LANDINGS_VIEW), т.к. смысл ALL_LANDINGS — увидеть больше, чем
  // выдано per-project правами; OWN_LANDINGS не завязан на права проектов вообще (свои же
  // созданные). Дефолт PROJECT_LANDINGS = ровно текущее поведение (LandingsService.
  // findAllForCompany, фильтр по LANDINGS_VIEW-грантам), так что существующие сотрудники не
  // теряют и не приобретают видимость молча при миграции.
  landingsVisibilityScope LandingsVisibilityScope @default(PROJECT_LANDINGS)

  // "Только свои клиенты" для Buyer (запрос пользователя 2026-08-03, переключатель по каждому
  // сотруднику отдельно, подтверждено AskUserQuestion) — ALL_CLIENTS = текущее поведение (все
  // клиенты доступных по ProjectAccess проектов), OWN_CLIENTS = только Client.buyerId === он сам.
  // Enum сознательно не переиспользует LandingsVisibilityScope — разное число вариантов и разная
  // семантика (тут нет промежуточного "по проектам", проектный скоуп уже даёт ProjectAccess).
  clientsVisibilityScope ClientsVisibilityScope @default(ALL_CLIENTS)

  // Короткий код баера в трекинг-ссылках (запрос пользователя 2026-08-20: "сократим значения
  // z=... но обязательно с обратной совместимостью для старых ссылок") — заменяет полный User.id
  // (25 символов) в скрытом параметре z=. Nullable до генерации (см. common/short-code.util.ts,
  // генерируется при создании пользователя во всех трёх местах, где он создаётся — AuthService.
  // register/TeamService.create/TeamInvitesService — и лениво не бэкафилится: если по какой-то
  // причине пуст, GetLinkDialog просто подставляет обычный id, ссылка чуть длиннее, но рабочая).
  buyerShortCode String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  company          Company @relation(fields: [companyId], references: [id])
  projectAccess    ProjectAccess[]
  refreshTokens    RefreshToken[]
  permissions      UserPermission[]
  adminActions     AdminActionLog[]
  createdLandings  Landing[]        @relation("LandingCreatedBy")
  createdPixels    TrackingPixel[]  @relation("PixelCreatedBy")

  @@index([companyId])
}

enum LandingsVisibilityScope {
  OWN_LANDINGS     // только созданные самим сотрудником (Landing.createdById = его id)
  PROJECT_LANDINGS // только проекты, где выдан LANDINGS_VIEW — текущее поведение, дефолт
  ALL_LANDINGS     // company-wide, без ограничения по проектам
}

enum ClientsVisibilityScope {
  ALL_CLIENTS // текущее поведение — все клиенты доступных по ProjectAccess проектов, дефолт
  OWN_CLIENTS // только клиенты, атрибутированные лично ему (Client.buyerId)
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  // Льготное окно ротации (запрос пользователя 2026-09-01: "многие говорят что их делогинит
  // часто") — тот же логин, открытый в нескольких вкладках/доменах (mw-track.com и
  // old.mw-track.com делят один refresh-токен ради SSO, см. auth.store.ts), почти всегда
  // получает ОДИН И ТОТ ЖЕ access-токен из общего localStorage и потому упирается в 401
  // практически одновременно — но ротация раньше была мгновенной (строка удалялась сразу),
  // так что вторая вкладка, обновляясь тем же уже использованным токеном, получала честный
  // "недействителен" и AuthService.refresh() принудительно разлогинивал пользователя целиком.
  // Теперь строка не удаляется сразу при первой ротации, а помечается supersededAt — повторное
  // предъявление В ПРЕДЕЛАХ REFRESH_TOKEN_GRACE_MS просто выдаёт свежую независимую пару
  // токенов вместо ошибки (не ту же самую пару — у RefreshToken и так никогда не было
  // ограничения "одна строка на пользователя", несколько параллельных живых сессий — штатный
  // случай, см. вход с телефона+ноутбука одновременно). За пределами окна — как и раньше,
  // честная ошибка (настоящий повторный проигрыш токена или реально истёкшая сессия).
  supersededAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([supersededAt])
}

// Инвайт-ссылка в команду (запрос пользователя 2026-07-04) — Owner/Admin создаёт ссылку с
// преднастроенной ролью (и проектами для BUYER/OPERATOR), приглашённый сам вводит email/пароль
// на публичной странице по токену. Токен = вся авторизация принятия приглашения, поэтому
// прочитывается через findUnique (не проходит через tenant-scoping middleware, см.
// PrismaService.modelsWithCompany — тот же паттерн, что у Domain/Channel).
// Revoke — хард-делит, не soft-delete: это транзитный токен-креденшл, а не запись данных
// компании, то же самое соображение, что и у RefreshToken (AuthService.logout — тоже delete()).
model TeamInvite {
  id           String    @id @default(cuid())
  companyId    String
  token        String    @unique
  role         UserRole
  projectIds   Json?     // string[] — только для BUYER/OPERATOR, применяется к ProjectAccess при accept
  permissions  Json?     // string[] (значения Permission) — тот же паттерн, что projectIds, применяется к UserPermission при accept
  createdById  String
  expiresAt    DateTime
  usedAt       DateTime?
  usedByUserId String?

  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId])
}

// Доступ рекламщика к конкретным проектам
model ProjectAccess {
  id        String @id @default(cuid())
  userId    String
  projectId String

  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
}

// Гранулярные права внутри доступных проектов (запрос пользователя 2026-07-17: "кто что
// может делать, удалять, создавать, менять лэндинги, пиксели, домены, пуши итд") — второе
// измерение поверх ProjectAccess: то не "к каким проектам есть доступ", а "что внутри
// доступного проекта разрешено". OWNER/ADMIN/SUPER_ADMIN никогда не получают строк — остаются
// безусловно полным доступом (см. assertAccess elevated-байпас), проверяются реально только
// BUYER/OPERATOR.
//
// projectId — запрос пользователя 2026-07-28: "чтобы под каждый проект можно было выбрать
// разрешения, а не общие". Раньше право было плоским на всего пользователя сразу (один набор
// действовал на всех его ProjectAccess-проектах одновременно) — теперь явно привязано к
// конкретному проекту, один и тот же Permission может быть выдан на одном проекте и не выдан
// на другом. DOMAINS_* — единственное деликатное исключение: домены технически не привязаны
// к одному проекту (см. Domain.projectId — чисто UI-подпись), поэтому по решению пользователя
// DOMAINS_*-права остаются общими на пользователя — приложение просто не показывает/не пишет
// для них разные projectId в UI (сама схема не запрещает это технически, ограничение только на
// уровне приложения, см. PermissionsService/Team UI).
model UserPermission {
  id         String     @id @default(cuid())
  userId     String
  projectId  String
  permission Permission
  createdAt  DateTime   @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId, permission])
  @@index([userId, projectId])
}

// ============================================================
// ПРОЕКТЫ
// ============================================================

model Project {
  id          String  @id @default(cuid())
  companyId   String
  name        String
  description String?
  status      ProjectStatus @default(ACTIVE)

  // IANA-строка (например "America/Bogota") — проект может целиться в аудиторию на другом
  // конце света, "сутки" во всех дневных графиках этого проекта (подписки/диалоги/события)
  // считаются по этой зоне, а не по UTC (запрос пользователя 2026-07-04, диалоги с клиентами).
  timezone String @default("UTC")

  // Кастомные имена query-параметров для генерируемых трекинг-ссылок лендинга (запрос
  // пользователя 2026-07-04, "получить ссылку" с пикселем + рекламными макросами Facebook/
  // TikTok) — { pixel: "px", adId: "zid1", campaignId: "zid2", ... }. null = дефолтные имена
  // (см. apps/api/src/modules/tracking/link-params.const.ts). Нужно потому что одинаковые
  // ?pixel=&ad_id= у всех клиентов платформы легко палятся спай-сервисами конкурентов.
  linkParamMap Json?

  // Токены для внешних интеграций
  publicToken  String @unique @default(cuid())  // для JS Snippet
  secretKey    String @unique                    // для серверного API

  // Разрешённые домены для CORS (внешние интеграции)
  allowedDomains String[] @default([])

  // Какие типы событий НЕ отправлять в рекламные платформы (Facebook/TikTok) — запрос
  // пользователя 2026-07-25: "настроить свитч кнопки которые будут отключать эти events".
  // Список валидных значений — apps/api/src/modules/tracking/tracking-event-types.const.ts
  // (PageView/Lead/Subscribe/Dialogue/Purchase/InitiateCheckout/Click). Пустой массив (по
  // умолчанию) = всё включено, поведение не меняется для существующих проектов. Событие
  // по-прежнему пишется в свою же CRM (TrackingEvent) независимо от этого списка — выключается
  // только пересылка на внешние площадки (см. TrackingService.recordEvent).
  disabledTrackingEvents String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  company       Company         @relation(fields: [companyId], references: [id])
  // 1:1 с 2026-07-02 — проект сам "становится" каналом, выбирается один раз при
  // создании (см. ProjectsService.create()), не добавляется отдельным шагом позже.
  // FK по-прежнему на Channel.projectId (см. @@unique там) — не сливаем поля Channel
  // в Project, чтобы не тащить десятки nullable tg*/wa*/ig* колонок на каждый проект.
  channel       Channel?
  pixels        TrackingPixel[] // проект не привязан к конкретной платформе — пикселей любых платформ может быть несколько одновременно (см. PixelPlatform)
  domains       Domain[]
  landings      Landing[]
  clients       Client[]
  pushes        Push[]
  events        TrackingEvent[]
  purchases     Purchase[]
  projectAccess ProjectAccess[]
  userPermissions       UserPermission[]
  automationFlows       AutomationFlow[]
  automationEnrollments AutomationEnrollment[]
  abTestGroups          AbTestGroup[]
  storyPosts            StoryPost[]
  personalBroadcasts    PersonalBroadcast[]
  paymentDetailsLogs    PaymentDetailsLog[]

  @@index([companyId])
  @@index([publicToken])
}

// ============================================================
// КАНАЛЫ ОБЩЕНИЯ
// ============================================================

model Channel {
  id        String      @id @default(cuid())
  projectId String
  type      ChannelType
  name      String
  isActive  Boolean     @default(true)
  lastError String?     // причина последней деактивации (initialize()/health-check) — показывается в UI
  // Время последнего входящего Telegram-вебхука (запрос пользователя 2026-08-05, после реального
  // ~20-часового инцидента: Telegram молча перестал слать вебхуки этому боту, пока другие боты
  // получали их как обычно — ни ошибок, ни падений процесса, обнаружить можно было только по
  // отсутствию новых Client-записей). Проставляется в TelegramProvider.handleWebhook на КАЖДЫЙ
  // входящий апдейт, независимо от типа — единственная общая точка входа до диспетчеризации
  // grammY по конкретным обработчикам. "Устарел ли вебхук" считается лениво при чтении
  // (ProjectsService.sanitizeChannel), тем же приёмом, что уже computed tgPersonalConnected —
  // не отдельный cron/сохранённый boolean, как у isActive.
  lastWebhookAt DateTime?

  // Telegram специфично
  tgBotToken     String?
  tgChannelId    String?  // числовой ID канала
  tgChannelUsername String? // @username — публичный канал, для PUBLIC_CHANNEL_DIRECT (ссылка на лендинге)
  tgBotUsername  String?
  // УСТАРЕВШИЕ поля одиночного приветственного сообщения (запрос пользователя 2026-07-03,
  // до 2026-07-25) — заменены сценарием с триггером SUBSCRIBE (см. BotScenarioTrigger,
  // TelegramProvider.triggerScenario) по запросу пользователя 2026-07-25: "убери с настроек
  // бота приветственное сообщение при подписке и добавь его в сценарии". НЕ удаляем колонки и
  // НЕ читаем/пишем их больше нигде в коде — тот же приём, что уже применён к устаревшим
  // одиночным полям BotScenario ниже; существующие значения были перенесены одноразовым
  // скриптом в BotScenarioStep при миграции.
  tgWelcomeMessage   String?
  tgWelcomeMediaType String? // 'PHOTO' | 'VIDEO' | 'VIDEO_NOTE' | 'VOICE' | 'DOCUMENT', null — без медиа
  tgWelcomeMediaKey  String? // ключ объекта в MinIO (trafficcrm-landings, welcome-media/<channelId>/<file>)
  tgWelcomeButtons   Json?   // [{ text, url }] — та же форма, что и Push.buttons
  // Задержка одобрения заявки на вступление (PRIVATE_CHANNEL_REQUEST), секунды — запрос
  // пользователя 2026-07-03, обсуждено перед разработкой. null/0 — без задержки (текущее
  // поведение, approveChatJoinRequest вызывается синхронно внутри вебхука). Client/Subscribe-
  // событие/пиксели пишутся МГНОВЕННО, в момент заявки, не задержкой — только сам вызов
  // approveChatJoinRequest и последующее приветственное сообщение откладываются через BullMQ
  // (queue join-request-approval, см. TelegramProvider.handleJoinRequest /
  // JoinRequestApprovalProcessor) — решение согласовано с пользователем: атрибуция для
  // рекламных площадок не должна плыть вместе с искусственной задержкой одобрения.
  tgJoinDelaySeconds Int?
  tgMode             TelegramMode? @default(BOT_DIRECT) // см. enum TelegramMode выше
  tgInviteLink       String?  // кэш invite-ссылки (creates_join_request:true) для PRIVATE_CHANNEL_REQUEST, создаётся в initialize()
  tgPersonalUsername String?  // личный @username для PERSONAL_DM — общение от своего лица, без бота и вебхука

  // Список @username менеджеров (запрос пользователя 2026-07-21: "если команда не захочет
  // подключать личный аккаунт, у них должна быть возможность регистрировать диалоги по-
  // другому, через приветственного бота"). Сообщения от этих username перехватываются ДО
  // обычной обработки клиента (TelegramProvider) — менеджер никогда не становится Client,
  // значит не попадает под пуши/воронки/автоворонки этого бота. Менеджер пересылает боту
  // сообщение клиента, бот ищет клиента по tgUserId настоящего отправителя пересылки и
  // предлагает подтвердить запись диалога. Без @, регистронезависимое сравнение.
  tgManagerUsernames String[] @default([])

  // MTProto-подключение личного аккаунта (PERSONAL_DM, запрос пользователя 2026-07-04) — не
  // Bot API, реальный вход в личный Telegram-аккаунт через GramJS, чтобы видеть входящие
  // диалоги (Bot API вообще не может ничего узнать про переписку личного аккаунта).
  // tgSessionEncrypted непустой = аккаунт подключён. Отключение просто обнуляет все три поля —
  // сессию нельзя "отозвать" так же просто, как бот-токен (см. EncryptionService).
  tgPersonalPhone    String?  // номер, использованный при входе
  tgPersonalUserId   String?  // свой Telegram user id — чтобы отличать свои исходящие от входящих в live-слушателе
  tgSessionEncrypted String?  // GramJS StringSession, AES-256-GCM (apps/api/src/common/encryption.service.ts)
  // Причина автоматического отключения (запрос пользователя 2026-08-06: "проверять раз в
  // некоторое время... уведомление и изменение статуса") — заполняется ТОЛЬКО когда
  // TelegramPersonalService.handleDeadSession сам отозвал сессию (AUTH_KEY_UNREGISTERED и т.п.),
  // НЕ при обычном ручном отключении из настроек (там disconnect() зовётся без reason, поле
  // остаётся/становится null) — так отличаем "никогда не было подключено" и "отключили сами" от
  // "было подключено, но Telegram отозвал сессию", не заводя отдельный булев флаг.
  tgPersonalLastError String?

  // Метаданные, подтянутые из Telegram в initialize() (getMe/getChat/getChatMemberCount) —
  // только для отображения в карточке канала в UI, не используются в бизнес-логике.
  // Для PERSONAL_DM всегда пустые — Bot API не даёт способа узнать что-либо о личном
  // аккаунте, с которым бот никогда не взаимодействовал.
  tgBotId               String?
  tgBotFirstName        String?
  tgChannelTitle        String?
  tgChannelMembersCount Int?
  tgAvatarFileId        String? // file_id фото канала (приоритетно) либо бота — см. ChannelsService.streamAvatar

  // WhatsApp специфично
  waPhoneNumberId String?
  waAccessToken   String?
  wa360Token      String? // 360dialog токен (D360-API-KEY)
  waWebhookUsername String? // Basic Auth для входящих вебхуков от 360dialog
  waWebhookPassword String? // генерируются нами при initialize(), не вводятся пользователем

  // Instagram специфично (через прямой Meta Graph API, Page Messenger Platform):
  // igPageId/igAccessToken вводит пользователь (Facebook Page ID + Page Access Token);
  // igBusinessAccountId заполняется нами в initialize() через GET /{igPageId}?fields=
  // instagram_business_account — это ID, который реально приходит в entry.id входящего
  // вебхука (НЕ igPageId, это частая путаница в документации Meta), нужен для роутинга
  // единого app-level вебхука на правильный Channel.
  igPageId             String?
  igAccessToken        String?
  igBusinessAccountId  String?

  // Viber специфично
  viberBotToken   String?
  viberWebhookUrl String?

  // Email специфично
  emailFromName   String?
  emailFromAddr   String?
  sendgridApiKey  String?

  // Обычный сайт специфично (ChannelType.WEBSITE, запрос пользователя 2026-09-03) — адрес
  // сайта, куда ведёт кнопка лендинга и куда WebsiteProvider.initialize() реально ходит для
  // проверки, что track.js установлен. Редактируется свободно (домен сайта может смениться) —
  // каждое изменение через ChannelsService.update() автоматически перезапускает проверку.
  websiteUrl String?

  // Иконка сайта для отображения в СРМ (запрос пользователя 2026-09-03: "для website такого нет,
  // можешь брать иконку подключенного сайта?") — в отличие от Telegram-аватара (свой файл,
  // скачивается и хранится у нас через bot API), это просто внешний URL, извлечённый регэкспом
  // из <link rel="icon"> HTML-страницы сайта в момент успешной верификации
  // (WebsiteProvider.initialize уже фетчит эту HTML для проверки тега track.js — извлечение
  // фавиконки не требует отдельного запроса). Устанавливается только при успехе проверки —
  // намеренно не трогается при провале, чтобы не терять последнюю известную иконку из-за
  // временной недоступности сайта.
  websiteFaviconUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id])
  botScenarios         BotScenario[]
  scenarioAbTestGroups ScenarioAbTestGroup[]
  storyPosts           StoryPost[]

  // Enforcing 1:1 — см. Project.channel выше.
  @@unique([projectId])
  @@index([projectId])
}

// Сценарии бота (запрос пользователя 2026-07-03) — команды + реакции на события (депозит/
// повторный депозит/отписка) + дефолтное сообщение на нераспознанный текст. Работает для
// любого Telegram-режима с реальным ботом (не PERSONAL_DM) — шире, чем приветственное
// сообщение (то только для PRIVATE_CHANNEL_REQUEST). См. TelegramProvider.triggerScenario.
enum BotScenarioTrigger {
  COMMAND
  FIRST_DEPOSIT   // "FD" — терминология запланированного модуля депозитов, см. память агента
  REPEAT_DEPOSIT  // "RD" (redeposit)
  UNSUBSCRIBE
  DEFAULT
  // Срабатывает в момент одобрения заявки на вступление (PRIVATE_CHANNEL_REQUEST) — замена
  // отдельного одиночного Channel.tgWelcomeMessage* (запрос пользователя 2026-07-25:
  // "приветственное сообщение при подписке" переносится из настроек бота в сценарии, тот же
  // движок цепочки шагов, что и у остальных триггеров, вместо отдельного одноразового
  // механизма). См. TelegramProvider.triggerScenario, вызывается вместо старого
  // sendWelcomeMessage.
  SUBSCRIBE
}

// A/B-тест сценариев (запрос пользователя 2026-07-25: "как мы сделали для груп лэндингов...
// нужно для сценариев сделать примерно так же") — тот же принцип, что AbTestGroup у лендингов
// (endedAt+resultsSnapshot вместо немедленного удаления при остановке), но БЕЗ привязки
// варианта к конкретному посетителю/клиенту (запрос пользователя подтверждён явно: "каждый раз
// заново случайно", та же модель, что уже принята для лендингов) — при каждом срабатывании
// триггера вариант выбирается заново взвешенным рандомом, см. TelegramProvider.triggerScenario.
model ScenarioAbTestGroup {
  id        String    @id @default(cuid())
  channelId String
  companyId String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  endedAt   DateTime?
  resultsSnapshot Json?

  channel   Channel       @relation(fields: [channelId], references: [id])
  scenarios BotScenario[]

  @@index([channelId])
}

model BotScenario {
  id        String @id @default(cuid())
  channelId String
  companyId String // тенант-скоуп, как у Landing/Client

  triggerType BotScenarioTrigger
  // Только для COMMAND (без слэша, например "price"). Для остальных типов — '' (пустая
  // строка, НЕ null): Postgres unique-индекс считает каждый NULL уникальным сам по себе,
  // только '' реально гарантирует "одна запись на (channel, triggerType)" для
  // синглтон-триггеров на уровне БД, а не только в коде.
  // ИСКЛЮЧЕНИЕ — A/B-варианты (isAbTestVariant=true): у них здесь синтетическое уникальное
  // значение (см. BotScenariosService.addAbTestVariant), а не реальная команда — иначе они
  // сталкивались бы с этим же unique-индексом и друг с другом, и с "основным" сценарием.
  // Настоящая команда/триггер варианта показывается в UI ИЗ ГРУППЫ, не из этого поля.
  command String @default("")

  isActive Boolean @default(true)

  // A/B-тест (см. ScenarioAbTestGroup выше) — null у обычного сценария без теста.
  // isAbTestVariant отличает "основной" сценарий группы (владеет настоящими triggerType+
  // command, найден TelegramProvider.triggerScenario обычным способом) от добавленных
  // альтернатив (найдены только через группу, у них command — служебное значение).
  abTestGroupId   String?
  abTestWeight    Int?
  isAbTestVariant Boolean @default(false)

  // Точка входа в цепочку шагов (запрос пользователя 2026-07-22: "объединить" сценарии с
  // автоворонками — тот же граф-паттерн, что у AutomationFlow.firstStepId/AutomationStep,
  // см. ниже BotScenarioStep/BotScenarioRun). Одношаговый вид (одно сообщение + одна задержка)
  // теперь частный случай цепочки из одного/двух шагов.
  firstStepId String?

  // УСТАРЕВШИЕ поля одиночного сообщения (до 2026-07-22) — НЕ удаляем и не читаем в новом
  // движке (BotScenarioEngineService целиком работает через firstStepId/BotScenarioStep).
  // Оставлены только для существующих строк, у которых уже есть данные здесь на момент
  // миграции — она переносит содержимое в BotScenarioStep и проставляет firstStepId, после
  // чего эти поля больше не используются никаким кодом ни на чтение, ни на запись.
  delaySeconds Int     @default(0)
  messageText  String?
  mediaType    String? // 'PHOTO' | 'VIDEO' | 'VIDEO_NOTE' | 'VOICE' | 'DOCUMENT'
  mediaKey     String? // ключ в MinIO (ChannelMediaService, префикс scenario-media/)
  buttons      Json?   // [{ text, url }]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  channel     Channel              @relation(fields: [channelId], references: [id])
  steps       BotScenarioStep[]
  runs        BotScenarioRun[]
  abTestGroup ScenarioAbTestGroup? @relation(fields: [abTestGroupId], references: [id])

  @@unique([channelId, triggerType, command])
  @@index([companyId, channelId])
  @@index([abTestGroupId])
}

enum BotScenarioStepType {
  DELAY
  SEND_MESSAGE
  CONDITION
}

// Тот же граф-паттерн, что AutomationStep (см. ниже) — один шаг = один узел,
// onSuccessStepId/onFailureStepId вместо порядкового номера. Общий редактор на фронтенде
// (StepAccordionEditor) умеет работать что с этой моделью, что с AutomationStep через один
// и тот же набор REST-маршрутов по форме (add/move/remove), хоть таблицы и разные.
model BotScenarioStep {
  id         String              @id @default(cuid())
  scenarioId String
  type       BotScenarioStepType

  // DELAY
  delaySeconds Int?

  // SEND_MESSAGE — messageMedia вместо одиночных mediaType/mediaKey: массив
  // [{type:'photo'|'video'|'video_note', url}], до 10 файлов (запрос пользователя 2026-07-22,
  // "до 10 других медиа" — тот же формат, что уже Push.messageMedia/CreatePushDto.messageMedia,
  // video_note только в одиночку).
  messageText  String?
  messageMedia Json?
  buttons      Json? // [{ text, url }]

  // CONDITION — тот же формат, что AutomationStep.conditionFilter (v1: {hasPurchase}).
  // Если у BotScenarioRun ещё нет clientId (холодный контакт без Client) — условие трактуется
  // как невыполненное, см. BotScenarioEngineService.evaluateCondition.
  conditionFilter Json?

  onSuccessStepId String?
  onFailureStepId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scenario BotScenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)

  @@index([scenarioId])
}

// Аналог AutomationEnrollment, но БЕЗ @@unique([scenarioId, tgUserId]) — в отличие от
// автоворонок, сценарий должен мочь запускаться заново для одного и того же человека каждый
// раз, когда происходит триггер (особенно REPEAT_DEPOSIT — повторный депозит по определению
// повторяется). tgUserId, а не clientId — сценарии (DEFAULT/COMMAND) обязаны уметь сработать
// и для холодного контакта, у которого Client ещё не существует вообще; clientId — если он
// на момент срабатывания уже есть (нужен для CONDITION-шагов).
model BotScenarioRun {
  id         String                     @id @default(cuid())
  scenarioId String
  tgUserId   String
  clientId   String?
  status     AutomationEnrollmentStatus @default(ACTIVE)
  currentStepId String?
  startedAt  DateTime  @default(now())
  completedAt DateTime?

  scenario BotScenario @relation(fields: [scenarioId], references: [id])

  @@index([scenarioId, status])
}

// ============================================================
// ДОМЕНЫ
// ============================================================

model Domain {
  id        String       @id @default(cuid())
  companyId String
  projectId String?
  domain    String
  status    DomainStatus @default(PENDING)

  sslStatus   String?     // active, pending, error

  // Верификация (TXT запись) + диагностика последней неудачной проверки/выпуска SSL
  verificationToken  String @unique @default(cuid())
  verifiedAt         DateTime?
  lastCheckError     String?

  // Soft delete: "удаление" из UI освобождает nginx/webhook/сертификат, но строка остаётся в БД
  // (история/аудит + возможность разобраться в инциденте позже). Уникальность домена поэтому
  // частичный индекс WHERE deletedAt IS NULL (см. миграцию) — плоский @unique заблокировал бы
  // повторное добавление того же хоста после "удаления".
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company      @relation(fields: [companyId], references: [id])
  project Project?     @relation(fields: [projectId], references: [id])
  paths   DomainPath[]

  @@index([companyId])
}

// Один домен → много лендингов/проектов через путь (2026-06-29, запрос пользователя:
// "один домен на несколько проектов и несколько лэндов используя /path/path"). Заменяет
// старую прямую связь Domain.landingId (1 домен = 1 лендинг на корне) — см.
// 04_BACKEND_PROJECTS_DOMAINS.md. Голый домен без явного маппинга пути ("/" в т.ч.) теперь
// никуда не ведёт (404) — раньше Domain.landingId неявно отдавал контент на корне.
model DomainPath {
  id        String   @id @default(cuid())
  domainId  String
  path      String   // нормализован: начинается с "/", без конечного слеша, кроме "/" самого
  // Ровно одно из двух (запрос пользователя 2026-07-17: "лить и на группу теста, и на каждый
  // лендинг отдельно") — путь либо на один конкретный лендинг (рендерится строго он, БЕЗ
  // сплита, даже если этот лендинг параллельно состоит в какой-то группе через другую ссылку),
  // либо сразу на AbTestGroup (тогда взвешенный сплит применяется всегда). Раньше сплит был
  // неявным свойством лендинга — теперь явное свойство конкретной ссылки. Проверяется
  // CHECK-констрейнтом на уровне БД (см. миграцию) + валидацией в DomainsService.upsertPath.
  landingId     String?
  abTestGroupId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  domain      Domain       @relation(fields: [domainId], references: [id], onDelete: Cascade)
  landing     Landing?     @relation(fields: [landingId], references: [id])
  abTestGroup AbTestGroup? @relation(fields: [abTestGroupId], references: [id])

  @@unique([domainId, path])
  @@index([domainId])
  @@index([abTestGroupId])
}

// ============================================================
// ЛЕНДИНГИ
// ============================================================

model Landing {
  id        String      @id @default(cuid())
  companyId String
  projectId String
  name      String
  type      LandingType @default(TEMPLATE)
  status    LandingStatus @default(DRAFT)

  // Для шаблонных лендингов
  templateId   String?  // ключ шаблона
  templateData Json?    // настройки: цвета, тексты, картинки

  // Для кастомных лендингов (ZIP загрузка)
  customFileUrl  String?  // путь в MinIO
  customBasePath String?  // путь где распакован

  // Для внешних лендингов (серверы клиента)
  isExternal Boolean @default(false)  // использует SDK

  // SEO
  metaTitle       String?
  metaDescription String?
  faviconUrl      String?

  // Персональная invite-ссылка (creates_join_request:true) для PRIVATE_CHANNEL_REQUEST —
  // отдельная от Channel.tgInviteLink (тот — общий fallback для захода в бота напрямую,
  // минуя лендинг). Создаётся один раз при публикации (LandingsService.publish()), не при
  // каждом рендере — рендер не должен дёргать внешний Telegram API. Позволяет точно
  // определить, с какого именно лендинга пришла заявка на вступление (TelegramProvider.
  // handleJoinRequest сверяет ctx.chatJoinRequest.invite_link с этим полем) — запрос
  // пользователя 2026-07-02, "подписчики отдельно на каждый лэнд".
  tgInviteLink String?

  // Авторедирект (запрос пользователя 2026-07-03): редирект в Telegram срабатывает сразу при
  // заходе на лендинг, без нажатия кнопки — LandingRendererService передаёт SDK URL редиректа
  // через data-атрибут, сам SDK шлёт Lead и делает window.location вместо ожидания клика.
  autoRedirect Boolean @default(false)

  // Клоакинг (тот же запрос): лендинг показывается только посетителям из разрешённых стран
  // (ISO 3166-1 alpha-2, верхний регистр), для всех остальных — редирект на cloakingRedirectUrl
  // (например, Wikipedia) вместо реального контента. Страна определяется в
  // LandingRendererService: сперва заголовок cf-ipcountry (когда домен клиента проксируется
  // через Cloudflare — не гарантировано, см. 04_BACKEND_PROJECTS_DOMAINS.md про self-service
  // домены без обязательного Cloudflare), иначе офлайн-геобаза geoip-lite по IP.
  cloakingEnabled     Boolean  @default(false)
  cloakingCountries   String[] @default([])
  cloakingRedirectUrl String?

  // Доп. инструкции для TikTok (запрос пользователя 2026-08-20) — встроенный браузер TikTok
  // (BytedanceWebview) иногда отказывается открывать страницу напрямую ("Мы не можем открыть
  // эту страницу непосредственно в TikTok") или блокирует переход по tg://-диплинку внутри себя
  // — известное ограничение самого TikTok/Android/iOS, не наш баг (WebKit/WebView внутри
  // сторонних приложений намеренно ограничивают переход по чужим URL-схемам и хэндофф во
  // внешний браузер, это платформенное ограничение, см. apps/sdk/src/browser.ts). Включает:
  // на Android — попытку авто-эскейпа во внешний браузер через intent://-URL; на iOS (которую
  // Apple не даёт форсировать программно) — подсказку нажать "···" и выбрать "Open in Browser".
  tiktokBrowserHint Boolean @default(false)

  // Тексты попапа-подсказки выше (запрос пользователя 2026-08-27, "как у конкурента" — форма
  // редактирования текстов, англ. по умолчанию). Json, а не отдельные колонки: семь опциональных
  // строк, которые всегда читаются/пишутся одним блоком и не нуждаются в отдельных индексах —
  // тот же принцип, что у PersonalBroadcast.variants/filter. Любой отсутствующий ключ = SDK
  // берёт свой встроенный английский дефолт (apps/sdk/src/browser.ts) — что и даёт UX "оставьте
  // пустым, чтобы вернуть значение по умолчанию" без отдельного sentinel-значения в БД.
  // Форма полей: title, subtitle, iosSteps (перевод строки = отдельный шаг), androidSteps
  // (аналогично — показывается как fallback, если авто-эскейп intent:// не сработал за 1.5с),
  // openButtonText, copyButtonText, copiedText (тот же текст дублируется на стрелке-указателе).
  tiktokHintTexts Json?

  // Своя аватарка лендинга (запрос пользователя 2026-07-04) — ключ объекта в MinIO
  // (StorageService, префикс landing-avatars/), НЕ хранится в templateData.CHANNEL_AVATAR:
  // тот вычисляется на лету при рендере (LandingRendererService.renderTemplate) — если
  // avatarKey не задан, используется фото канала (Channel.tgAvatarFileId) как дефолт "изначально
  // как в канале", подставить которое можно только зная на момент рендера реальное состояние
  // канала, а не то, что было при создании лендинга.
  avatarKey String?

  // A/B/n-тестирование (Фаза 3.2, запрос пользователя 2026-07-15, расширено тем же днём с
  // пары до произвольного числа вариантов) — лендинг может состоять в одной AbTestGroup,
  // abTestWeight — его доля трафика внутри группы (сумма весов участников группы = 100).
  // Оба/все лендинги создаются баером заранее, независимо, со своим контентом — не
  // клонирование одного в другие, см. LandingRendererService.resolveAbTestVariant (сплит
  // трафика) и LandingsService/AbTestGroupsController (CRUD группы).
  abTestGroupId String?
  abTestWeight  Int?
  abTestGroup   AbTestGroup? @relation(fields: [abTestGroupId], references: [id])

  // Кто создал (запрос пользователя 2026-08-03) — nullable: у лендингов, созданных до этого
  // поля, автора нет, миграция бэкфиллит его на Owner компании (см. саму миграцию), а не
  // NOT NULL с фиктивным значением. Тот же паттерн, что уже есть у Purchase.registeredBy —
  // "кто выполнил действие", опционально, без onDelete-каскада (пользователей никогда не
  // хард-делят, см. инвариант в CLAUDE.md, так что ссылка не повиснет).
  createdById String?
  createdBy   User?   @relation("LandingCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  company Company  @relation(fields: [companyId], references: [id])
  project Project  @relation(fields: [projectId], references: [id])
  domainPaths DomainPath[]
  clients     Client[]

  @@index([companyId, projectId])
}

// A/B/n-группа лендингов (Фаза 3.2) — companyId плоской колонкой для скоупинга, без
// @relation на Company, тот же приём, что и в AutomationFlow (не всем моделям, требующим
// company-скоупинга, нужна обратная ссылка с той стороны). "Остановить тест" — soft-delete
// этой строки + Landing.abTestGroupId/abTestWeight = null у всех участников (см.
// LandingsService.stopAbTestGroup) — не заводим 4-е исключение из "no hard deletes".
model AbTestGroup {
  id        String    @id @default(cuid())
  projectId String
  companyId String
  // Необязательное человекочитаемое название (запрос пользователя 2026-07-17) — если не
  // задано, фронтенд показывает автосгенерированную подпись из имён участников (см.
  // LandingCard.abTestGroupLabel).
  name      String?
  // Завершение теста (запрос пользователя 2026-07-17) — раньше остановка теста сразу ставила
  // deletedAt, статистика нигде не сохранялась. Теперь это два разных состояния: endedAt
  // задан + deletedAt пуст = завершён, виден в истории с застывшими цифрами; deletedAt задан =
  // запись удалена из истории насовсем (обычный soft-delete). resultsSnapshot считается один
  // раз при остановке (LandingsService.stopAbTestGroup), с начала теста (createdAt) до момента
  // остановки — НЕ то же самое, что live-статистика лендинга (та за всё время жизни лендинга).
  endedAt         DateTime?
  resultsSnapshot Json?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  project     Project      @relation(fields: [projectId], references: [id])
  landings    Landing[]
  domainPaths DomainPath[]

  @@index([projectId])
}

// ============================================================
// КЛИЕНТЫ (CRM)
// ============================================================

// Источник первой регистрации диалога (Client.dialogueSource, запрос пользователя 2026-07-23) —
// три реальных способа поставить firstDialogueAt, см. ClientsService.applyDialogueUpdate:
enum DialogueSource {
  PERSONAL_ACCOUNT // реальное входящее сообщение с личного MTProto-аккаунта (TelegramPersonalService)
  BOT_DIRECT       // сообщение боту в режиме tgMode=BOT_DIRECT (там сам бот и есть диалог)
  MANAGER_CONFIRM  // менеджер переслал сообщение боту и подтвердил ("Да, диалог")
  CRM_BUTTON       // кнопка "Зарегистрировать" в списке клиентов
}

model Client {
  id          String  @id @default(cuid())
  companyId   String
  projectId   String
  // Каким лендингом привлечён — заполняется только когда источник надёжно определим
  // (сейчас: PRIVATE_CHANNEL_REQUEST через персональную invite-ссылку лендинга, см.
  // Landing.tgInviteLink). Для PUBLIC_CHANNEL_DIRECT остаётся null навсегда — Telegram
  // не даёт боту знать, с какой страницы пришёл вступивший в публичный канал.
  landingId   String?
  // Через какую группу A/B/n-теста пришёл клиент — запрос пользователя 2026-08-20: "не нужно
  // учитывать статистику каждого лэндинга по отдельности, даже если эти лэндинги проливаются
  // отдельно... группа лэндингов как отдельная сущность со своей статой разделенной". Ставится
  // ОДИН РАЗ, только когда заход реально прошёл через сплит группы (LandingRendererService.
  // pickAbTestGroupVariant, resolved.abTestGroupId — путь ведёт на ГРУППУ, не на конкретный
  // лендинг напрямую), и с этого момента не меняется, независимо от Landing.abTestGroupId
  // (тот отражает ТЕКУЩЕЕ членство лендинга, которое после создания группы больше нельзя менять
  // именно из-за этой статистики — см. assertValidMembers/updateAbTestGroup). Без @relation —
  // та же мягкая ссылка, что и у buyerId/pixelId выше, не формальный FK.
  abTestGroupId String?
  // Реальная invite-ссылка, по которой пришла заявка на вступление (запрос пользователя
  // 2026-08-31: "как это показано у наших конкурентов" — карточка клиента) — PRIVATE_CHANNEL_
  // REQUEST only, TelegramProvider.handleJoinRequest уже читает её из webhook-события
  // (ctx.chatJoinRequest.invite_link.invite_link) для сопоставления атрибуции, просто раньше не
  // сохранял. Может быть как одноразовой per-visit ссылкой (см. createOneTimeInviteLink), так и
  // общей ссылкой лендинга/канала (fallback-путь) — в любом случае это честная запись того, чем
  // реально воспользовался человек, не восстановленная задним числом.
  tgInviteLink String?

  // Telegram данные
  tgUserId    String?
  tgUsername  String?
  tgFirstName String?
  tgLastName  String?
  tgLanguage  String?
  // Telegram file_id профильного фото клиента (не URL, несмотря на имя поля — как и у
  // Channel.tgAvatarFileId, байты стримятся отдельным авторизованным эндпоинтом, см.
  // ClientsController, потому что file_id сам по себе не является рабочей ссылкой).
  tgPhotoUrl  String?
  // Telegram User.is_premium — приходит бесплатно на каждом апдейте от Telegram, раньше не читалось.
  tgIsPremium Boolean?

  // WhatsApp данные
  waPhone    String?
  waName     String?

  // Instagram данные
  igUserId   String?
  igUsername String?

  // Анонимный визитор чистого веб-сайта (ChannelType.WEBSITE, без Telegram/WA/IG вообще) —
  // персистентный localStorage id, генерируется apps/sdk/src/browser.ts, шлётся с каждым
  // событием. НЕ @unique — дедуп у Client всегда app-level через findFirst в
  // ClientsService.buildIdentityWhere, ни у одного identity-поля нет DB-level unique.
  visitorId  String?

  // Контактные данные (если собрали через форму)
  email      String?
  phone      String?

  // Трекинг
  fbclid     String?
  ttclid     String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmContent  String?
  utmTerm     String?

  // Рекламные макросы Facebook/TikTok (ad_id/campaign_id/...) + пиксель, к которому привязан
  // клик (запрос пользователя 2026-07-04, трекинг-ссылки лендинга) — заполняются из того же
  // start:<code> Redis-блока, что уже несёт fbclid/utm через границу браузер→Telegram (см.
  // LandingRendererService.injectTrackingScripts). pixelId — если клик пришёл по ссылке с
  // конкретным пикселем, все последующие события этого клиента роутятся только туда
  // (см. TrackingProcessor.sendToPlatforms), а не всем активным пикселям проекта.
  pixelId        String?
  adId           String?
  adName         String?
  adsetId        String?
  adsetName      String?
  campaignId     String?
  campaignName   String?
  placement      String?
  siteSourceName String?

  // Метка баера (Фаза 3.6, Team Analytics, запрос пользователя 2026-07-15) — id User, который
  // сгенерировал трекинг-ссылку (скрытый query-параметр, см. GetLinkDialog/link-params.ts), не
  // управленческий аккаунт (Owner/Admin/SuperAdmin — те ссылку без метки, клиент "БЕЗ БАЕРА").
  // Без @relation — та же мягкая ссылка, что и у pixelId выше, не формальный FK.
  buyerId String?

  // Технические данные
  ipAddress   String?
  userAgent   String?
  country     String?
  city        String?
  // ISO 3166-1 alpha-2 код страны (например "ru"), отдельно от country выше (там — то, что
  // показывается в UI: для браузерных клиентов полное название с ip-api.com, для Telegram —
  // уже код через geoip-lite/Cloudflare cf-ipcountry, историческая нестыковка форматов, не
  // трогаем). countryCode — специально под Facebook Advanced Matching (запрос пользователя
  // 2026-07-29, сверка с реальным примером конкурента): FB требует именно alpha-2 код,
  // хэшированный, полное название дало бы хэш, который никогда не совпадёт с хэшем FB.
  countryCode String?
  // Facebook Browser ID (_fbp cookie, запрос пользователя 2026-07-29, тот же сверенный пример
  // конкурента) — ставит fbevents.js (см. LandingRendererService.injectTrackingScripts, базовый
  // пиксель уже подключён) сразу на лендинге; сюда долетает через ?fbp= на клике по Telegram-
  // кнопке (apps/sdk/src/browser.ts) → TrackingController.tgRedirect, тем же путём, что и
  // fbclid/ip/userAgent (start:<code> / landing-visit-attribution:<landingId> Redis-мосты).
  fbp         String?

  // Статусы
  channelType   ChannelType?
  isSubscribed  Boolean @default(true)   // в канале
  isBotActive   Boolean @default(true)   // не заблокировал бота
  hasPurchase   Boolean @default(false)

  // Финансы
  totalSpent     Decimal @default(0) @db.Decimal(10,2)
  purchasesCount Int     @default(0)

  // Диалог (запрос пользователя 2026-07-04) — общий концепт для бот-каналов (ChannelsService.
  // recordInboundMessage, вызывается из TelegramProvider.handleIncomingText) и личного
  // MTProto-аккаунта (TelegramPersonalService) — единая точка учёта независимо от типа канала.
  // firstDialogueAt = первое входящее сообщение от клиента (через БОТА ИЛИ личный аккаунт),
  // не наше исходящее.
  firstDialogueAt      DateTime?
  lastDialogueAt       DateTime?
  dialogueMessageCount Int @default(0)
  // Источник ПЕРВОЙ регистрации диалога (запрос пользователя 2026-07-23: "сделай чтобы можно
  // было технически отследить откуда зарегистрирован диалог" — баг-репорт про диалог,
  // отмеченный у клиента, который реально не писал) — ставится один раз, вместе с
  // firstDialogueAt, в ClientsService.applyDialogueUpdate, дальше не меняется (повторные
  // сообщения из другого источника не переписывают её). Специально не добавляли кнопку "убрать
  // диалог" — событие Dialogue, уже отправленное в Facebook, всё равно не отозвать.
  dialogueSource DialogueSource?
  // botActivatedAt — отдельно от firstDialogueAt (баг-репорт пользователя 2026-07-17: пуши
  // падали с "chat not found" для клиентов, чей firstDialogueAt пришёл от личного MTProto-
  // аккаунта, а не от бота — у бота с ними никогда не было чата). Ставится ТОЛЬКО когда
  // сообщение реально пришло через бота (TelegramProvider), а не через личный аккаунт
  // (TelegramPersonalService) — единственный надёжный сигнал "бот технически может прислать
  // этому клиенту пуш", используется в ClientsService.buildPushFilterWhere и метрике
  // "активировали бота" вместо firstDialogueAt.
  botActivatedAt DateTime?

  // Временные метки
  firstSeenAt    DateTime  @default(now())
  subscribedAt   DateTime?
  lastActiveAt   DateTime?
  unsubscribedAt DateTime?

  // Дата последнего депозита (запрос пользователя 2026-08-06: рассылка с личного аккаунта,
  // фильтр "по давности депозита") — Purchase полностью общий, нет отдельной сущности "депозит"
  // (см. purchasesCount/totalSpent выше — тот же денормализованный подход), даты последнего
  // события раньше не было нигде. Проставляется в PurchasesService.create рядом с уже
  // существующим инкрементом totalSpent/purchasesCount.
  lastPurchaseAt DateTime?

  // Вступил в приватный канал (PRIVATE_CHANNEL_REQUEST), но НЕ через нашу заявку/лендинг —
  // запрос пользователя 2026-07-21 ("внешние контакты... те кто подписался недавно, не по
  // нашей воронке"). Намеренно ОТДЕЛЬНО от subscribedAt — subscribedAt зарезервирован только
  // за настоящей атрибуцией воронки (используется в статистике/рекламной атрибуции по всему
  // проекту, см. choke points в CLAUDE.md); эти люди остаются во "Внешних контактах", просто
  // с реальной датой вступления вместо пустой, а не переезжают в "наших клиентов".
  externalSubscribedAt DateTime?
  // Покинул канал — для внешних контактов (запрос пользователя 2026-07-24: "почему нельзя
  // отслеживать если он отписался и задать как всем дату отписки"). Намеренно ОТДЕЛЬНОЕ поле
  // от unsubscribedAt, не переиспользуем его — баг-репорт 2026-07-21 уже был ровно про то, что
  // unsubscribedAt на внешнем контакте показывал вводящий в заблуждение статус "Отписался" для
  // того, кто никогда не был подписан через воронку в принципе. ClientsService.markUnsubscribed
  // теперь ставит то или другое поле в зависимости от того, "наш" клиент или "внешний".
  externalUnsubscribedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  project   Project    @relation(fields: [projectId], references: [id])
  landing   Landing?   @relation(fields: [landingId], references: [id])
  purchases Purchase[]
  pushLogs  PushLog[]
  events    TrackingEvent[]
  automationEnrollments AutomationEnrollment[]
  personalBroadcastLogs PersonalBroadcastLog[]
  paymentDetailsLogs    PaymentDetailsLog[]

  @@index([companyId, projectId])
  @@index([tgUserId, projectId])
  @@index([landingId])
  @@index([abTestGroupId])
  @@index([fbclid])
  @@index([visitorId])
}

// ============================================================
// ТРЕКИНГ СОБЫТИЙ
// ============================================================

model TrackingEvent {
  id          String           @id @default(cuid())
  projectId   String
  clientId    String?

  eventName   String           // PageView, Lead, Purchase, etc.
  eventTime   DateTime         @default(now())
  eventId     String           @unique  // для дедупликации FB

  // Данные события
  payload     Json             // полный payload

  // Источник события
  source      EventSource @default(SERVER)  // browser, server, sdk

  // Роутинг + разбивка по рекламе (запрос пользователя 2026-07-04, трекинг-ссылки лендинга) —
  // реальные колонки (не только внутри payload), чтобы разбивка по кампании/объявлению была
  // индексируемой, тот же принцип, что eventName/source уже вынесены из JSON. pixelId задан —
  // если событие пришло по ссылке с конкретным привязанным пикселем (см. TrackingProcessor);
  // если null — рассылается всем активным пикселям проекта, как и раньше.
  pixelId        String?
  adId           String?
  adName         String?
  adsetId        String?
  adsetName      String?
  campaignId     String?
  campaignName   String?
  placement      String?
  siteSourceName String?
  // Атрибуция баера на уровне события (запрос пользователя 2026-08-03: "почему нельзя показывать
  // стату с личными параметрами") — тот же принцип, что pixelId/campaignId выше: SDK уже читает
  // buyerRef из URL и шлёт его на КАЖДОМ событии (включая PageView/Lead, до создания Client), но
  // бэкенд раньше эту колонку не сохранял, поэтому просмотры/клики нельзя было приписать баеру —
  // не архитектурный тупик, просто недостающая проводка (см. TrackingService.resolveAttribution).
  // NULL у всех событий ДО этой миграции — атрибуция не ретроактивна, как и у pixelId/campaignId
  // в своё время.
  buyerId        String?

  createdAt DateTime @default(now())

  project    Project                 @relation(fields: [projectId], references: [id])
  client     Client?                 @relation(fields: [clientId], references: [id])
  deliveries TrackingEventDelivery[] // статус отправки в КАЖДЫЙ привязанный к проекту пиксель отдельно — одно событие может уйти на N пикселей N разных платформ

  @@index([projectId, eventName])
  @@index([projectId, createdAt])
  @@index([projectId, campaignId])
  @@index([projectId, adId])
  @@index([projectId, buyerId])
}

// ============================================================
// ПИКСЕЛИ (FACEBOOK CAPI / TIKTOK EVENTS / ...)
// ============================================================

// Проект сам по себе не привязан к платформе — пикселей может быть несколько
// (несколько FB-аккаунтов, FB+TikTok разом и т.д.), каждый со своими credentials.
model TrackingPixel {
  id        String        @id @default(cuid())
  projectId String
  platform  PixelPlatform
  label     String?       // для различения нескольких пикселей одной платформы в UI

  pixelId       String  // Facebook Pixel ID / TikTok Pixel Code
  accessToken   String  // CAPI / Events API access token
  testEventCode String? // только Facebook, для отладки CAPI

  isActive  Boolean  @default(true)

  // Кто создал (запрос пользователя 2026-08-03) — тот же паттерн, что у Landing.createdById
  // (см. её комментарий) выше по файлу.
  createdById String?
  createdBy   User?   @relation("PixelCreatedBy", fields: [createdById], references: [id])

  // Короткий код пикселя в трекинг-ссылках (запрос пользователя 2026-08-20) — тот же принцип,
  // что и User.buyerShortCode выше: заменяет полный TrackingPixel.id (25 символов) в параметре
  // pixel=, генерируется при создании (PixelsService.create), не ретроактивен.
  shortCode String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project    Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  deliveries TrackingEventDelivery[]

  @@index([projectId])
}

// Один ряд на пару (событие, пиксель) — раньше статус отправки хранился прямо
// в TrackingEvent двумя колонками (fbStatus/ttStatus), что подразумевало ровно
// один FB-пиксель и один TikTok-пиксель на проект. Теперь пикселей много.
model TrackingEventDelivery {
  id              String   @id @default(cuid())
  eventId         String
  pixelId         String
  status          String   // sent, error
  externalEventId String?  // ID, который вернула платформа (например fbEventId от Facebook)
  error           String?
  // Реальные тело запроса к Facebook/TikTok и ответ платформы (запрос пользователя 2026-07-28:
  // "сделай как у конкурентов, полностью с отчётом" — раньше в логах пикселей UI показывал
  // только внутренний TrackingEvent.payload, не то, что РЕАЛЬНО ушло/пришло). access_token НЕ
  // входит ни в то, ни в другое — у Facebook он отдельным полем в обёртке вокруг eventData
  // (см. FacebookCAPIService), у TikTok — в HTTP-заголовке, не в теле; секрет пикселя сюда не
  // попадает.
  // @db.Json (не jsonb по умолчанию) — запрос пользователя 2026-07-29: показывать "точь-в-точь"
  // порядок ключей реального запроса/ответа, jsonb его не сохраняет (пересобирает в свой
  // внутренний бинарный формат), plain json хранит исходный текст как есть.
  requestPayload  Json?    @db.Json
  responsePayload Json?    @db.Json
  httpStatus      Int?     // реальный HTTP-код ответа платформы (конкурентский пример показывал его отдельной строкой)
  sentAt          DateTime @default(now())

  event TrackingEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  pixel TrackingPixel @relation(fields: [pixelId], references: [id], onDelete: Cascade)

  @@unique([eventId, pixelId])
  @@index([eventId])
}

// ============================================================
// ПОКУПКИ
// ============================================================

model Purchase {
  id        String @id @default(cuid())
  projectId String
  clientId  String

  amount    Decimal @db.Decimal(10,2)
  currency  String  @default("USD")

  // Внешний ID заказа (от системы клиента)
  externalOrderId String?
  idempotencyKey  String? @unique

  // Регистрация
  registeredBy String?  // userId кто добавил вручную, null если API/бот
  source       String   @default("manual")  // manual, api, bot, webhook

  // Трекинг отправлен?
  fbSent Boolean @default(false)
  ttSent Boolean @default(false)

  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id])
  client  Client  @relation(fields: [clientId], references: [id])

  @@index([projectId])
  @@index([clientId])
}

// ============================================================
// ПУШИ (РАССЫЛКИ)
// ============================================================

model Push {
  id        String     @id @default(cuid())
  projectId String
  name      String
  status    PushStatus @default(DRAFT)

  // Контент
  messageText  String
  messageMedia Json?    // { type: 'photo'|'video', url: '...' }
  buttons      Json?    // [{ text: '...', url: '...' }]

  // Фильтр аудитории
  filter Json  // PushFilter объект

  // Предварительный расчёт аудитории
  audienceTotal    Int @default(0)   // всего в базе по фильтру
  audienceReachable Int @default(0)  // из них доступны для пуша

  // Планирование
  scheduledAt DateTime?

  // Результаты
  sentAt       DateTime?
  sentCount    Int @default(0)
  deliveredCount Int @default(0)
  failedCount  Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project   @relation(fields: [projectId], references: [id])
  logs    PushLog[]

  @@index([projectId])
  // Скан крона отложенных рассылок (status='SCHEDULED' AND scheduledAt<=now(), запрос
  // пользователя 2026-07-18) — без индекса на реальном объёме был бы full scan таблицы.
  @@index([status, scheduledAt])
}

// Лог отправки пуша каждому клиенту
model PushLog {
  id       String     @id @default(cuid())
  pushId   String
  clientId String
  // pending (строка создана заранее, ждёт отправки) -> sending (джоба атомарно захватила
  // получателя, идёт реальная отправка) -> sent | failed (запрос пользователя 2026-09-01,
  // "почисти старые без отправки и сделай полноценный фикс" — до этого строка создавалась
  // РЕАКТИВНО внутри самой джобы отправки, а не заранее: если процесс падал ДО того, как джоба
  // вообще была поставлена в очередь (например `pm2 restart` посреди цикла постановки джоб на
  // тысячи получателей в PushesService.send), для этих получателей не существовало вообще
  // никакого следа — ни строки, ни джобы — а Push уже был переведён в SENDING и не поддавался
  // повторному send() (EDITABLE_STATUSES). Теперь строки на ВСЮ аудиторию создаются заранее
  // (см. PushesService.ensureLedger), поэтому "кто ещё не отправлен" всегда можно узнать по
  // status='pending', и PushesCron.recoverStalledSending может безопасно доставить рассылку
  // после сбоя — то же решение, что уже применено к PersonalBroadcastLog.
  status   String
  error    String?
  sentAt   DateTime?
  // Первый клик по любой кнопке этого отправления (Фаза 3.4, Smart Push Timing) — первая
  // клик-трекинг функция в проекте, см. TrackingController.pushClickRedirect и
  // pushes.processor.ts (переписывает Push.buttons[].url на трекинг-редирект перед отправкой).
  // Засчитывается один раз (повторные клики того же получателя не раздувают CTR).
  clickedAt DateTime?

  push   Push   @relation(fields: [pushId], references: [id])
  client Client @relation(fields: [clientId], references: [id])

  @@index([pushId])
  @@index([pushId, status])
  // Один получатель — одна строка на пуш (запрос пользователя 2026-09-01) — без этого
  // createMany({skipDuplicates:true}) в ensureLedger не смог бы реально предотвратить дубли
  // при повторном вызове (recoverStalledSending может звать его многократно). Перед добавлением
  // ограничения на реальных данных нашлись и вручную удалены 2 старые дублирующиеся строки
  // (оба случая — зависшая 'pending' от той же самой обрываемой процессом джобы, второй ряд —
  // настоящий терминальный sent/failed от неё же).
  @@unique([pushId, clientId])
}

// ============================================================
// РАССЫЛКА С ЛИЧНОГО АККАУНТА (MTProto, запрос пользователя 2026-08-06) — параллельная
// Push'у фича, не режим существующей: механизм отправки (GramJS через
// TelegramPersonalService, не Bot API), модель аудитории (диалог именно с личным аккаунтом —
// Client.dialogueSource='PERSONAL_ACCOUNT', не reachability бота) и темп отправки
// (сконфигурированная пауза между каждым получателем, не очередь с лимитом) достаточно разные,
// чтобы не переиспользовать Push/PushLog напрямую. Не в modelsWithCompany — тот же ручной
// scoping через projectId + assertAccess, что уже у Push (см. CLAUDE.md choke points).
// ============================================================

model PersonalBroadcast {
  id        String                  @id @default(cuid())
  projectId String
  name      String
  status    PersonalBroadcastStatus @default(DRAFT)

  // Варианты контента (запрос пользователя: "загрузить например 2 варианта, и половине
  // аудитории отправится один вариант а второй половине второй") — массив
  // {messageText, media?, buttons?}, а не одно сообщение, как у Push.messageText/messageMedia —
  // получателю достаётся один вариант по round-robin (PersonalBroadcastLog.variantIndex).
  variants Json

  // Фильтр аудитории — PersonalBroadcastFilterDto, заметно богаче PushFilterDto (депозиты,
  // давность депозита, диалог, подписки, папка Telegram) — см. модуль personal-broadcasts.
  filter Json

  // Пауза между отправками — случайный интервал [min,max], не фиксированное число: сам по себе
  // разброс — анти-спам сигнал (запрос пользователя: "если делать очень быстро, телеграм может
  // заблокировать за спам"). Личный аккаунт — не бот, с ним куда строже.
  delayMinSeconds Int @default(15)
  delayMaxSeconds Int @default(45)

  scheduledAt DateTime?
  sentAt      DateTime?

  audienceTotal Int @default(0)
  sentCount     Int @default(0)
  failedCount   Int @default(0)
  // Диалог не подтвердился живой проверкой прямо перед отправкой (client.getInputEntity не
  // резолвится) — запрос пользователя: "так же проверять сразу если диалог реально есть".
  skippedCount  Int @default(0)

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project                @relation(fields: [projectId], references: [id])
  logs    PersonalBroadcastLog[]

  @@index([projectId])
  @@index([status, scheduledAt])
}

model PersonalBroadcastLog {
  id           String    @id @default(cuid())
  broadcastId  String
  // clientId стал опциональным (запрос пользователя 2026-08-06: "пушить не только клиентов
  // пришедших через нашу срм, но и всех остальных, даже внешних") — получатель теперь может
  // быть живым Telegram-диалогом без соответствующей строки Client вообще (см.
  // TelegramPersonalService.getAllDialogs). tgUserId/tgFirstName/tgUsername — снапшот на момент
  // создания рассылки, единственный надёжный источник для получателей БЕЗ clientId (join через
  // client в этом случае невозможен).
  clientId     String?
  tgUserId     String
  tgFirstName  String?
  tgUsername   String?
  variantIndex Int
  status       String    @default("pending") // pending, sending (claimed, in-flight), sent, failed, skipped
  error        String?
  sentAt       DateTime?

  broadcast PersonalBroadcast @relation(fields: [broadcastId], references: [id])
  client    Client?           @relation(fields: [clientId], references: [id])

  @@index([broadcastId, status])
}

enum PersonalBroadcastStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  FAILED
  CANCELLED
}

// Журнал реквизитов (запрос пользователя 2026-08-27) — антифрод-контроль: оператор,
// оперирующий подключённым личным Telegram-аккаунтом напрямую (мимо CRM), теоретически может
// подменить настоящие реквизиты компании своими и увести деньги клиента себе. Пишется
// TelegramPersonalService из реального события "исходящее сообщение" (см.
// NewMessage({outgoing:true}) — тот же механизм, что уже слушает входящие для handleIncomingMessage,
// только для исходящих), НЕ ретроактивным чтением истории — фича работает только вперёд с
// момента подключения обработчика, старые сообщения не сканируются (см. память/CLAUDE.md о
// том, почему ретроактивное чтение переписки не делается). v1 по явному решению пользователя:
// просто логирует ФАКТ отправки реквизитов, без сверки с "официальным" списком — сверка
// (обнаружение самой подмены, а не только факта) осознанно отложена.
model PaymentDetailsLog {
  id          String   @id @default(cuid())
  projectId   String
  channelId   String
  // Получатель — почти всегда реальный Client (диалог уже отслеживается), но clientId
  // опционален на случай холодного контакта без записи Client (тот же case, что и у
  // PersonalBroadcastLog.clientId) — tgUserId остаётся источником истины всегда.
  clientId    String?
  tgUserId    String
  // Снапшот отображаемого имени на момент отправки (запрос пользователя 2026-08-29: "почему
  // айди а не имя") — для получателей БЕЗ Client (см. clientId выше) единственный источник
  // хоть какого-то имени, тот же приём, что и PersonalBroadcastLog.tgFirstName/tgUsername.
  // Резолвится best-effort через event.message.getChat() — тот же метод, который уже один раз
  // подвёл (см. tgUserId выше) для РЕЗОЛВА ID получателя, но для ИМЕНИ альтернативы нет:
  // Telegram не отдаёт профиль по голому numeric id без access_hash, который есть только если
  // локальный кэш сессии уже "видел" этого пользователя — иногда попытка неудачна, тогда оба
  // поля остаются null и в UI показывается голый tgUserId, как и раньше.
  tgFirstName String?
  tgUsername  String?
  messageText String   @db.Text
  // Дата самого сообщения в Telegram (event.message.date), не момента записи в БД —
  // могут отличаться при ретраях обработчика/задержке processing.
  sentAt      DateTime
  createdAt   DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id])
  client  Client? @relation(fields: [clientId], references: [id])

  @@index([projectId, sentAt])
}

// ============================================================
// МОДУЛЬ "ИСТОРИИ" (Telegram Stories из личных MTProto-аккаунтов, запрос
// пользователя 2026-07-21) — публикация Stories напрямую из CRM в уже подключённый
// личный Telegram-аккаунт (см. Channel.tgSessionEncrypted/TelegramPersonalService).
// Доступно для канала ЛЮБОГО TelegramMode — режим не ограничивает, важен только
// сам факт channel.type === TELEGRAM и наличие подключённого личного аккаунта.
// ============================================================

enum StoryPostStatus {
  PENDING
  PUBLISHING
  PUBLISHED
  FAILED
}

enum StoryMediaType {
  PHOTO
  VIDEO
}

model StoryPost {
  id        String @id @default(cuid())
  companyId String
  projectId String
  channelId String

  // Ключ в MinIO (ChannelMediaService, тот же бакет, что и медиа пушей) — байты скачиваются
  // из хранилища в момент публикации и передаются в GramJS напрямую (в отличие от медиа пушей,
  // которое Bot API само фетчит по публичной ссылке — MTProto так не умеет), поэтому этот
  // эндпоинт раздачи НЕ публичный, см. StoriesController.
  mediaKey  String
  mediaType StoryMediaType
  caption   String?

  // null = опубликовать как можно скорее (следующий тик крона, см. StoriesCron) — намеренно
  // тот же тик, что и у "запланировано на конкретное время", один код-путь вместо двух.
  scheduledAt DateTime?

  status      StoryPostStatus @default(PENDING)
  publishedAt DateTime?
  error       String?

  createdByUserId String

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  project Project @relation(fields: [projectId], references: [id])
  channel Channel @relation(fields: [channelId], references: [id])

  @@index([status, scheduledAt])
  @@index([companyId, projectId])
}

// ============================================================
// АВТОВОРОНКИ (Drip Campaigns, Фаза 3.1, запрос пользователя 2026-07-15)
// ============================================================

enum AutomationStepType {
  DELAY
  SEND_PUSH
  CONDITION
}

enum AutomationEnrollmentStatus {
  ACTIVE
  COMPLETED // дошёл до конца цепочки шагов
  EXITED    // условие-шлюз не выполнилось
  FAILED    // непредвиденная ошибка выполнения шага (например, зацикливание графа)
}

model AutomationFlow {
  id        String  @id @default(cuid())
  projectId String
  companyId String
  name      String
  // 'Subscribe' | 'Purchase' | 'Dialogue' — те же строки, что TrackingEvent.eventName,
  // отдельный enum не заводим, чтобы не рассинхронизировать с KNOWN_EVENT_NAMES
  // (apps/api/src/modules/tracking/dto/track-event.dto.ts).
  triggerEvent String
  isActive     Boolean @default(true)
  firstStepId  String? // точка входа в цепочку шагов (см. AutomationStep)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  project     Project                 @relation(fields: [projectId], references: [id])
  steps       AutomationStep[]
  enrollments AutomationEnrollment[]

  @@index([projectId, triggerEvent, isActive])
}

// Один шаг = один узел графа. onSuccessStepId/onFailureStepId — указатель "куда дальше", не
// порядковый номер (у DELAY/SEND_PUSH используется только onSuccessStepId, onFailureStepId
// всегда null). Это уже граф, не плоский список — в v1 UI onFailureStepId никогда не ведёт
// никуда, кроме null (= "выйти из воронки"), поэтому будущее ветвление (разные шаги для да/нет
// после CONDITION) не потребует миграции схемы — только смены UI/движка.
model AutomationStep {
  id     String             @id @default(cuid())
  flowId String
  type   AutomationStepType

  // DELAY
  delaySeconds Int?

  // SEND_PUSH — та же форма контента, что у BotScenario (переиспользует ScenarioMessageEditor
  // на фронтенде)
  messageText String?
  mediaType   String?
  mediaKey    String?
  buttons     Json?

  // CONDITION — v1: минимальное подмножество (только hasPurchase), формат заложен на вырост
  // под остальные поля наподобие PushFilterDto (country/minSpent/inactiveDaysMin...)
  conditionFilter Json?

  onSuccessStepId String?
  onFailureStepId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  flow AutomationFlow @relation(fields: [flowId], references: [id], onDelete: Cascade)

  @@index([flowId])
}

model AutomationEnrollment {
  id            String                     @id @default(cuid())
  flowId        String
  projectId     String
  clientId      String
  status        AutomationEnrollmentStatus @default(ACTIVE)
  currentStepId String? // null = уже завершён (COMPLETED/EXITED/FAILED)
  enrolledAt    DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt
  completedAt   DateTime?

  flow    AutomationFlow @relation(fields: [flowId], references: [id])
  project Project        @relation(fields: [projectId], references: [id])
  client  Client         @relation(fields: [clientId], references: [id])

  // Клиент проходит через конкретную воронку не больше одного раза (упрощение v1) — повторный
  // триггер того же события для уже когда-то enrolled клиента не создаёт вторую запись.
  @@unique([flowId, clientId])
  @@index([projectId])
}

// ============================================================
// БИЛЛИНГ
// ============================================================

// Инвойс — это пополнение баланса, а не покупка конкретного тарифа: оплата
// одинаковая для любой суммы, тариф выбирается/продлевается отдельно списанием
// с уже пополненного баланса (см. BalanceTransaction и BillingService.selectPlan).
model Invoice {
  id        String        @id @default(cuid())
  companyId String

  amount    Decimal @db.Decimal(10,2) // сколько пополняем
  currency  String  @default("USDT")

  status    InvoiceStatus @default(PENDING)

  // SELF_HOSTED (свои HD-адреса, см. CryptoPaymentService) или HELEKET (хостед-гейтвей,
  // см. HeleketGatewayProvider) — готовится к интеграции, см. 10_BACKEND_BILLING.md
  provider String @default("SELF_HOSTED")

  // Крипто оплата
  network        String?   // TRC20, ERC20, BEP20 (SELF_HOSTED) или код сети Heleket (HELEKET)
  paymentAddress String?   // адрес для оплаты
  txHash         String?   // хэш транзакции
  paidAmount     Decimal?  @db.Decimal(10,2)
  paidAt         DateTime?
  expiresAt      DateTime  // 30 минут на оплату

  // Только для provider=HELEKET — uuid инвойса на их стороне (нужен для запроса статуса/resend-webhook)
  gatewayUuid String?

  // Свип на счёт владельца (CryptoPaymentService.sweepToOwner) — best-effort после оплаты,
  // не блокирует зачисление баланса; sweepError != null = крон retryFailedSweeps попробует снова
  sweptAt     DateTime?
  sweepTxHash String?
  sweepError  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company             Company              @relation(fields: [companyId], references: [id])
  balanceTransactions BalanceTransaction[]

  @@index([companyId])
  @@index([paymentAddress])
}

// Леджер баланса: пополнения (TOPUP, привязаны к Invoice) и автосписания за подписку
// (SUBSCRIPTION_CHARGE — успешное продление/выбор тарифа, DOWNGRADE — не хватило
// средств, тариф сброшен до TRIAL). Один источник правды для "Истории операций" в UI.
model BalanceTransaction {
  id           String                 @id @default(cuid())
  companyId    String
  type         BalanceTransactionType
  amount       Decimal                @db.Decimal(10, 2) // + для TOPUP, - для SUBSCRIPTION_CHARGE, 0 для DOWNGRADE
  balanceAfter Decimal                @db.Decimal(10, 2)
  plan         SubscriptionPlan? // на какой тариф списание/даунгрейд — не задан для TOPUP
  invoiceId    String? // какой инвойс пополнил баланс — только для TOPUP
  createdAt    DateTime               @default(now())

  company Company  @relation(fields: [companyId], references: [id])
  invoice Invoice? @relation(fields: [invoiceId], references: [id])

  @@index([companyId, createdAt])
}

enum BalanceTransactionType {
  TOPUP
  SUBSCRIPTION_CHARGE
  DOWNGRADE
  // Ручное начисление супер-админом (Фаза 4.3C, запрос пользователя 2026-07-19) — намеренно
  // отдельное значение, не переиспользует TOPUP с invoiceId: null, чтобы отчёты, фильтрующие
  // по TOPUP, не путали ручные начисления с реальными крипто-платежами.
  ADMIN_CREDIT
}

// ============================================================
// ENUMS
// ============================================================

// Команда/роли (запрос пользователя 2026-07-04, Фаза 1) — BUYER заменяет ADVERTISER (то же
// самое, "медиабайер", просто более точное имя), OPERATOR новый — под клиентов/депозиты.
// SUPER_ADMIN — платформенная роль, вне иерархии компании, не участвует в Team-функционале.
enum UserRole {
  SUPER_ADMIN
  OWNER
  ADMIN
  BUYER
  OPERATOR
  // Project-scoped как BUYER/OPERATOR (не elevated, свой ProjectAccess) — запрос пользователя
  // 2026-07-30. Единственная задача: создавать/редактировать участников с ролью OPERATOR в
  // пределах СВОИХ проектов (см. team-role.util.ts assertOperatorAdminScope). Пустой
  // DEFAULT_ROLE_PERMISSIONS — не потребляет ресурсы проекта сама.
  OPERATOR_ADMIN
}

// Гранулярные права по типам ресурсов (запрос пользователя 2026-07-17) — см. UserPermission.
// Группировка по ресурсу с суффиксами VIEW/CREATE/EDIT/DELETE (кроме PUSHES — SEND вместо
// EDIT, и CHANNEL — только VIEW/MANAGE, т.к. настройки канала/бота не разбиваются на
// create/edit/delete отдельно).
enum Permission {
  // Настройки самого проекта (домены/таймзона/трекинг-переключатели и т.п., PATCH
  // /projects/:id) — запрос пользователя 2026-07-28, найдено как дыра при аудите: раньше не
