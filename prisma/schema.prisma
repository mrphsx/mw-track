// 4 способа, которыми лендинг может вести в Telegram (2026-06-29) — выбираются независимо
// от ChannelType=TELEGRAM, который один; определяет и куда ведёт кнопка "Вступить" на
// лендинге, и какой механизм подписки/атрибуции работает на бэкенде. См. Channel ниже.
enum TelegramMode {
  BOT_DIRECT              // кнопка открывает чат с ботом (атрибуция полная, дефолт)
  PRIVATE_CHANNEL_REQUEST // кнопка открывает бота (атрибуция сохраняется), бот шлёт invite-ссылку на вступление, сам её одобряет
  PUBLIC_CHANNEL_DIRECT   // кнопка ведёт прямо в публичный канал, без бота (атрибуция по клику слабее)
  PERSONAL_DM             // кнопка открывает личный диалог с указанным аккаунтом — без бота вообще, без вебхука, без CRM-данных
}

