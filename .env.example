# App
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:3001
# CDN_URL — публичный бакет MinIO с track.js (apps/sdk), НЕ путать с MINIO_BUCKET
# (приватный бакет кастомных лендингов, апи отдаёт его сам, не напрямую из MinIO)
CDN_URL=http://localhost:9000/trafficcrm-cdn

# Database (docker-compose dev services use DB_* directly; DATABASE_URL is what Prisma reads)
DB_NAME=trafficcrm
DB_USER=trafficcrm
DB_PASSWORD=trafficcrm
DATABASE_URL=postgresql://trafficcrm:trafficcrm@localhost:5432/trafficcrm

# Redis
REDIS_PASSWORD=trafficcrm
REDIS_URL=redis://:trafficcrm@localhost:6379

# JWT
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too

# MinIO
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=trafficcrm
MINIO_SECRET_KEY=trafficcrm123
MINIO_BUCKET=trafficcrm-landings
MINIO_CDN_BUCKET=trafficcrm-cdn

# Crypto wallets — TRC-20 (TRON). Оплата принимается на адрес, выведенный из
# TRON_HD_MNEMONIC; свип на OWNER_PAYOUT_ADDRESS_TRC20 оплачивается отдельным
# газовым кошельком TRON_GAS_PRIVATE_KEY (НЕ из той же мнемоники — изоляция намеренная).
# Без TRON_GAS_PRIVATE_KEY/OWNER_PAYOUT_ADDRESS_TRC20 свип просто не выполняется
# (оплата всё равно зачисляется на Company.balance, см. 10_BACKEND_BILLING.md).
TRON_HD_MNEMONIC=
TRONGRID_API_KEY=
TRONGRID_FULL_HOST=https://api.trongrid.org
USDT_TRC20_CONTRACT=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t
TRON_GAS_PRIVATE_KEY=
SWEEP_GAS_TRX_AMOUNT=30
OWNER_PAYOUT_ADDRESS_TRC20=

# Crypto wallets — EVM (ERC-20 на Ethereum, BEP-20 на BSC). Один ETH_HD_MNEMONIC
# обслуживает обе сети — адрес/деривация secp256k1 у EVM-чейнов одинаковы, отличаются
# только RPC/контракт USDT/decimals (Binance-Peg USDT на BSC — 18 знаков, не 6!).
ETH_HD_MNEMONIC=
INFURA_PROJECT_ID=
ETH_RPC_URL=
BSC_RPC_URL=https://bsc-dataseed.binance.org
USDT_ERC20_CONTRACT=0xdAC17F958D2ee523a2206206994597C13D831ec
USDT_BEP20_CONTRACT=0x55d398326f99059fF775485246999027B3197955
ETHERSCAN_API_URL=https://api.etherscan.io/api
ETHERSCAN_API_KEY=
BSCSCAN_API_URL=https://api.bscscan.com/api
BSCSCAN_API_KEY=
ETH_GAS_PRIVATE_KEY=
BSC_GAS_PRIVATE_KEY=
SWEEP_GAS_ETH_AMOUNT=0.005
SWEEP_GAS_BNB_AMOUNT=0.01
OWNER_PAYOUT_ADDRESS_EVM=
SWEEP_GAS_TRX_AMOUNT=30

# Heleket — хостед-крипто-гейтвей, готовится к интеграции (см. 10_BACKEND_BILLING.md).
# Без этих двух значений /billing/topup/heleket не работает; остальной биллинг не зависит от этого.
HELEKET_API_URL=https://api.heleket.com/v1
HELEKET_MERCHANT_ID=
HELEKET_API_KEY=

# Домены клиентов (self-service) — клиент сам управляет DNS, мы только проверяем TXT и выпускаем
# SSL через Certbot. Платформа не держит Cloudflare API-токен.
CERTBOT_EMAIL=admin@yourdomain.com
SERVER_PUBLIC_IP=

# Instagram Direct — один вебхук на всё приложение (не per-channel), настраивается один раз
# в Meta App Dashboard. META_APP_SECRET — реальный App Secret из dashboard, вставьте сами.
META_APP_SECRET=
# META_WEBHOOK_VERIFY_TOKEN — придумываем сами (не финансовый секрет), но то же значение
# нужно вставить в Meta App Dashboard при настройке Callback URL вебхука.
META_WEBHOOK_VERIFY_TOKEN=
