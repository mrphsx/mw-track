{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      { "include": "modules/landings/templates/**/*", "outDir": "dist", "watchAssets": true },
      { "include": "modules/landings/sdk-version.json", "outDir": "dist", "watchAssets": true }
    ]
  }
}
