    "nanoid": "^3.3.15",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1",
    "telegram": "^2.26.22",
    "tiny-secp256k1": "^2.2.4",
    "tronweb": "^6.3.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
