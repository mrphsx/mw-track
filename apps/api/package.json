    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^7.4.2",
    "@prisma/client": "^5.22.0",
    "adm-zip": "^0.5.17",
    "bcryptjs": "^3.0.3",
    "bip32": "^5.0.1",
    "bip39": "^3.1.0",
    "bullmq": "^5.79.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
