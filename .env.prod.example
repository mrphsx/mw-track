# Продакшен-переменные — apps/api/Dockerfile/docker-compose.prod.yml читают этот файл
# через env_file. Скопировать в .env.prod на сервере и заполнить реальными значениями.
# НЕ коммитить .env.prod.

NODE_ENV=production
PORT=3001

# Публичные домены — должны совпадать с infra/nginx/conf.d/main.conf и
# infra/scripts/setup-ssl.sh (DOMAINS)
APP_URL=https://app.yourdomain.com
API_URL=https://api.yourdomain.com
# Запекается в JS-бандл фронтенда во время docker build (см. apps/web/Dockerfile) —
# это публичный API-домен, НЕ localhost (см. feedback_dev_server_process_hygiene
# в памяти: localhost внутри фронтенда работает только для запросов с того же
# хоста, что и сам бэкенд, а не для браузера пользователя/внешнего трафика)
NEXT_PUBLIC_API_URL=https://api.yourdomain.com/api/v1
# Ссылка "Платформа (админ)" в выпадающем меню apps/web (видна только SUPER_ADMIN) — куда
# ведёт отдельное приложение apps/admin (Фаза 4.3). Временно путь на основном домене вместо
# поддомена (см. nginx location /adminmw), пока не сделана Фаза 4.3E.
NEXT_PUBLIC_ADMIN_URL=https://app.yourdomain.com/adminmw
# Отдельный (не тот же, что API_URL!) домен под редирект "кнопка лендинга -> Telegram" — чтобы
# рекламные платформы (Facebook/TikTok) не видели связь с основным доменом при автоматическом
# сканировании ссылки в объявлении. Тот же бэкенд физически, просто другое публичное имя,
# требует своего nginx server-блока + сертификата (см. память feedback_telegram_redirect_...).
TG_REDIRECT_BASE_URL=https://redirect.yourdomain.com
# CORS: список доменов, которым разрешено обращаться к API. Без этой переменной
# main.ts (apps/api/src/main.ts) разрешает '*' — приемлемо в dev, недопустимо в проде.
ALLOWED_ORIGINS=https://app.yourdomain.com

# Database (контейнер postgres в docker-compose.prod.yml использует DB_* напрямую,
# Prisma читает DATABASE_URL — это must указывать на сервис "postgres", не на localhost)
DB_NAME=trafficcrm
DB_USER=trafficcrm
DB_PASSWORD=сгенерировать-длинный-случайный-пароль
DATABASE_URL=postgresql://trafficcrm:сгенерировать-длинный-случайный-пароль@postgres:5432/trafficcrm

# Redis (сервис "redis", не localhost)
REDIS_PASSWORD=сгенерировать-длинный-случайный-пароль
REDIS_URL=redis://:сгенерировать-длинный-случайный-пароль@redis:6379

# MinIO (сервис "minio" в docker-compose.prod.yml, не localhost) — хранилище
# кастомных ZIP-лендингов (Фаза 2.3), читается приватно через API, бакет не публичный
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=trafficcrm
MINIO_SECRET_KEY=сгенерировать-длинный-случайный-пароль
MINIO_BUCKET=trafficcrm-landings
# Публичный бакет для track.js (Фаза 2.4, apps/sdk) — public-read policy,
# отдаётся через cdn.yourdomain.com (infra/nginx/conf.d/main.conf), не напрямую :9000
MINIO_CDN_BUCKET=trafficcrm-cdn
CDN_URL=https://cdn.yourdomain.com

# JWT — длинные случайные строки, разные между собой
JWT_SECRET=
JWT_REFRESH_SECRET=

# Crypto-биллинг — HD-кошельки + отдельные газовые кошельки для свипа на счёт владельца.
# НИКОГДА не передавать мнемонику/приватные ключи через чат/лог/CI — сгенерировать прямо
# на сервере и вписать в .env.prod вручную. Скомпрометированный секрет = риск потери всех
# денег, осевших на адресах, выведенных из него (см. 10_BACKEND_BILLING.md).
TRON_HD_MNEMONIC=
TRONGRID_API_KEY=
TRONGRID_FULL_HOST=https://api.trongrid.org
USDT_TRC20_CONTRACT=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t
TRON_GAS_PRIVATE_KEY=
SWEEP_GAS_TRX_AMOUNT=30
OWNER_PAYOUT_ADDRESS_TRC20=

ETH_HD_MNEMONIC=
INFURA_PROJECT_ID=
ETH_RPC_URL=
BSC_RPC_URL=https://bsc-dataseed.binance.org
USDT_ERC20_CONTRACT=0xdAC17F958D2ee523a2206206994597C13D831ec
USDT_BEP20_CONTRACT=0x55d398326f99059fF775485246999027B3197955
ETHERSCAN_API_URL=https://api.etherscan.io/api
ETHERSCAN_API_KEY=
BSCSCAN_API_URL=https://api.bscscan.com/api
BSCSCAN_API_KEY=
ETH_GAS_PRIVATE_KEY=
BSC_GAS_PRIVATE_KEY=
SWEEP_GAS_ETH_AMOUNT=0.005
SWEEP_GAS_BNB_AMOUNT=0.01
OWNER_PAYOUT_ADDRESS_EVM=

# Heleket — хостед-крипто-гейтвей, готовится к интеграции (см. 10_BACKEND_BILLING.md).
HELEKET_API_URL=https://api.heleket.com/v1
HELEKET_MERCHANT_ID=
HELEKET_API_KEY=

# Домены клиентов (self-service, Фаза 2.2) — клиент сам управляет DNS своего домена
# (в своём Cloudflare-аккаунте или любом другом), мы только проверяем TXT-запись и выпускаем
# SSL через Certbot, когда A/CNAME реально указывает на нас. Платформа НЕ держит Cloudflare
# API-токен и не управляет DNS клиента — решение принято 2026-06-27, см. 04_BACKEND_PROJECTS_DOMAINS.md.
CERTBOT_EMAIL=admin@yourdomain.com
SERVER_PUBLIC_IP=

# Instagram Direct (Фаза 2.6) — один вебхук на всё приложение (не per-channel), Callback URL
# https://api.yourdomain.com/api/v1/webhooks/instagram настраивается один раз в Meta App Dashboard.
# META_APP_SECRET — реальный App Secret из dashboard, вставьте сами.
META_APP_SECRET=
# META_WEBHOOK_VERIFY_TOKEN — придумываем сами (сгенерируйте длинную случайную строку), но то же
# значение нужно вставить в Meta App Dashboard при настройке Callback URL вебхука.
META_WEBHOOK_VERIFY_TOKEN=

# Диалоги с клиентами (Фаза 2.11) — шифрование секретов в БД (MTProto-сессия личного
# Telegram-аккаунта). Сгенерировать один раз: openssl rand -base64 32 — менять нельзя,
# существующие зашифрованные сессии перестанут расшифровываться при смене ключа.
SESSION_ENCRYPTION_KEY=
# Личный Telegram-аккаунт через MTProto (не Bot API) — получить на my.telegram.org
# ("API development tools"), одна пара credentials на всё приложение, не per-канал.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
